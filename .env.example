# Copy to .env and edit. Every value here is read by docker-compose.yaml.
#
# Generate the two passwords rather than inventing them:
#   openssl rand -base64 24

# ---------------------------------------------------------------------------
# MariaDB
# ---------------------------------------------------------------------------
# These same values must be typed into the /setup wizard on first run.
MYSQL_DATABASE=churchcrm
MYSQL_USER=churchcrm
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Host interface and port. 127.0.0.1 because the reverse proxy is local.
# Use 0.0.0.0 only if the proxy reaches this container over the network.
CRM_BIND_ADDR=127.0.0.1
CRM_PORT=80

# Public URL users will type in their browser, trailing slash required.
# Must match the reverse proxy's external address exactly.
# ChurchCRM validates this pattern: ^https?://\S+/$ (ConfigLoader::validateUrl)
CRM_PUBLIC_URL=https://crm.example.org/

# Leave empty for a root install; set e.g. /churchcrm only for a subdirectory.
CRM_ROOT_PATH=

# Apache ServerName. Any FQDN; silences the AH00558 startup warning.
CRM_SERVER_NAME=crm.example.org

# Which sources may set X-Forwarded-For. Apache rewrites REMOTE_ADDR only for
# these. Keep it to the proxy's address/CIDR — a wider range lets any client
# forge its own IP in the audit log.
# Default above covers Docker's bridge networks, which is what a reverse proxy
# on the same host appears as after DNAT.
CRM_TRUSTED_PROXY=172.16.0.0/12

# Image tag produced by ./build.sh. Bump VERSION in build.sh and re-run to upgrade.
CRM_IMAGE=dvalin21/churchcrm:7.7.1-apache